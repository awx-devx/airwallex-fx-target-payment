{
  "name": "airwallex-fx-target-payment",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "worker": "node --env-file=.env --import tsx src/worker/index.ts",
    "db:indexes": "node --env-file=.env --import tsx scripts/db-indexes.ts",
    "airwallex:smoke": "node --env-file=.env --import tsx scripts/airwallex-smoke.ts",
    "seed:beneficiaries": "node --env-file=.env --import tsx scripts/seed-beneficiaries.ts",
    "seed:demo": "node --env-file=.env --import tsx scripts/seed-demo.ts",
    "seed:generate": "node --env-file=.env --import tsx scripts/seed-generate.ts",
    "seed:reset": "node --env-file=.env --import tsx scripts/seed-reset.ts",
    "gen:invoices": "node --env-file=.env --import tsx scripts/gen-invoices.ts",
    "test:visual": "playwright test",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:extraction": "node --env-file=.env --import tsx scripts/test-extraction.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@napi-rs/canvas": "^1.0.10",
    "@paper-design/shaders-react": "0.0.81",
    "@tanstack/react-query": "^5.104.0",
    "bullmq": "^6.3.11",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^6.0.0",
    "lightweight-charts": "^5.2.1",
    "lossless-json": "^4.3.1",
    "lucide-react": "^1.49.0",
    "mongoose": "^9.10.4",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
