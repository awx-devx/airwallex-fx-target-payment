    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10",
    "fast-check": "^4.10.2",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3",
    "redis-memory-server": "^0.17.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
